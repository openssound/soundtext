<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements di SoundText.app con il runtime "hardened" (richiesto dalla
  notarizzazione Apple; con la firma ad-hoc non servono ma non fanno danno).
  Li applica packaging/macos/build-macos.sh. Niente sandbox dell'App Store:
  SoundText legge plugin e file dell'utente ovunque.
-->
<plist version="1.0">
<dict>
	<!-- registrare dal microfono o dalla scheda audio (tracce audio) -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- caricare plugin VST3 e Audio Unit di altri produttori e libsfizz,
	     che non sono firmati con il certificato di SoundText -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
